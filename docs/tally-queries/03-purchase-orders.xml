<ENVELOPE>
 <HEADER><VERSION>1</VERSION><TALLYREQUEST>Export</TALLYREQUEST><TYPE>Collection</TYPE><ID>SSB Purchase Orders</ID></HEADER>
 <BODY><DESC>
  <STATICVARIABLES>
   <SVCURRENTCOMPANY>Seven Seas Beauty Products Pvt Ltd (HR)</SVCURRENTCOMPANY>
   <SVFROMDATE TYPE="Date">20250401</SVFROMDATE>
   <SVTODATE TYPE="Date">20270331</SVTODATE>
   <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
  </STATICVARIABLES>
  <TDL><TDLMESSAGE>
   <COLLECTION NAME="SSB Purchase Orders" ISMODIFY="No">
    <TYPE>Voucher</TYPE>
    <FETCH>Date, VoucherNumber, VoucherTypeName, PartyLedgerName, IsCancelled, GUID, AlterID, AllInventoryEntries.*</FETCH>
    <FILTER>SSBIsPO</FILTER>
   </COLLECTION>
   <SYSTEM TYPE="Formulae" NAME="SSBIsPO">$VoucherTypeName = "Purchase Order"</SYSTEM>
  </TDLMESSAGE></TDL>
 </DESC></BODY>
</ENVELOPE>