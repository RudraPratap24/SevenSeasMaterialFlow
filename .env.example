# Copy to .env (or run: npm run env:init) — never commit the real .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# The exact address people open in the browser.
APP_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app (Caddy/Nginx = 1).
TRUST_PROXY=0
TZ=Asia/Kolkata

# Database — the app connects with this least-privilege account (created by db:setup).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=seven_seas_flow
DB_USER=flow_app
DB_PASSWORD=
DB_SSL=false
# MySQL host patterns the app account may connect from.
DB_APP_HOSTS=localhost,127.0.0.1

# Admin account used ONLY by "npm run db:setup" to create the database and the app account.
# Remove these two lines after setup on a production server.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# Encrypts sensitive fields at rest. BACK THIS UP SEPARATELY — without it the
# encrypted data in the database (and in its backups) cannot be read.
DATA_ENCRYPTION_KEY=

SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# TallyPrime's HTTP port and company, for "npm run tally -- fetch" (read only). Never expose the port to a network.
TALLY_URL=http://localhost:9000
TALLY_COMPANY=Seven Seas Beauty Products Pvt Ltd (HR)
# Lets "npm run tally -- push <PO>" create POs in Tally. Keep false on the live books until Accounts agrees.
TALLY_ALLOW_WRITE=true
# Test copies only (Educational mode accepts only the 1st or 2nd): the date given to POs sent to Tally, yyyymmdd.
TALLY_TEST_DATE=
# Names of the Purchase Order voucher types in Tally (comma-separated), for "npm run tally -- import / fetch".
TALLY_PO_VOUCHER_TYPES=Purchase Order
# How often the sync runs (npm run tally -- watch, started by npm run dev), in seconds.
TALLY_SYNC_SECONDS=30

# Lets the admin's "Load demo data" / "Clear all" buttons wipe the registers. Keep false on the live system.
ALLOW_DEMO_RESET=true
