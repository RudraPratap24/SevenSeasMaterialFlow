{
  "name": "seven-seas-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "npm run typecheck && npm run build:server",
    "build:server": "esbuild server/src/index.ts server/scripts/setup.ts server/scripts/user.ts server/scripts/master.ts server/scripts/init-env.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "start": "node dist-server/src/index.mjs",
    "typecheck": "tsc --noEmit -p server",
    "env:init": "tsx server/scripts/init-env.ts",
    "db:setup": "tsx server/scripts/setup.ts",
    "user": "tsx server/scripts/user.ts",
    "test": "node server/test/run.mjs",
    "master": "tsx server/scripts/master.ts",
    "master:import": "tsx server/scripts/importMaster.ts",
    "ps:import": "tsx modules/purchase-system/server/import.ts",
    "master:photos": "tsx server/scripts/importPhotos.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
